platform :ios, '15.0'
source 'https://cdn.cocoapods.org'

inhibit_all_warnings!  # 关闭所有警告

target 'MBCoder' do
#  use_frameworks!

  pod 'FMDB'
  pod 'FMDB/FTS'
  pod 'FMDB/SQLCipher'
  
  pod 'Protobuf'
  pod 'libextobjc'
  pod 'YogaKit'
  pod 'PromiseKit'
  pod 'PromiseKit/Foundation'
  pod 'PromiseKit/UIKit'
  pod 'lottie-ios', '~> 2.5.3'
  pod 'SVGAPlayer', '~> 2.3.5'
  pod 'UITableView+FDTemplateLayoutCell'
  pod 'VasSonic'
  pod 'HybridPageKit'
  pod 'YYKit', git: 'https://github.com/SAGESSE-CN/YYKit.git'
  pod 'FDFullscreenPopGesture'
  pod 'TZScrollViewPopGesture' # 和FDFullscreenPopGesture库不冲突
  pod 'KVOController'
  pod 'MMKV'
  pod 'GPUImage'
  pod 'FBMemoryProfiler'
  
  target 'MBCoderUITests' do
    inherit! :search_paths
    pod 'Kiwi'
  end

end

post_install do |installer|
  minimum_target = Gem::Version.new('15.0')

  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      deployment_target = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      next if deployment_target && Gem::Version.new(deployment_target) >= minimum_target

      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = minimum_target.to_s
    end
  end
end
